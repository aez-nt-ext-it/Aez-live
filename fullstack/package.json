{
  "name": "aez-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./public/tailwind-input.css -o ./public/tailwind.css --minify",
    "test:browser": "node scripts/browser-check.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1",
