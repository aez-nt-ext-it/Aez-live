PORT=3100
APP_ORIGIN=http://localhost:3100
# Production requires PostgreSQL and HTTPS. Empty URL uses local PGlite for development.
DATABASE_URL=
# Supabase pooler on some hosts needs the downloaded root certificate.
# For local Windows, use an absolute path such as C:\path\to\supabase-ca.crt.
PGSSLROOTCERT=
# For hosts where file paths are awkward, paste the certificate text into this env var instead.
PGSSLROOTCERT_CONTENT=
GOOGLE_CLIENT_ID=178807966999-j9p2ub2kimt46avtqsplm7jc20t9b5k4.apps.googleusercontent.com
ADMIN_EMAILS=anandrajekma23@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUMMARY_RECIPIENTS=
# Required for external cron endpoints. Use a long random value in production.
CRON_SECRET=
# Keep false on Render free; external cron should trigger daily summary.
ENABLE_INTERNAL_SUMMARY_WORKER=false
NODE_ENV=development
